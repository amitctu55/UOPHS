<script src="//ajax.googleapis.com/ajax/libs/jquery/1.10.2/jquery.min.js"></script>

	<script>
		$(document).ready(function(){
			
			$('.viewtrainee').change(function(){
				var vid=this.value;
				var subcenterid=$('option:selected', this).attr('data-uid');
				var uri="<?=base_url()?>trainee/traineeview/fetchdata";
				
					if ( $(this).hasClass("dpr") ) 
					{   
						var type='dpr'; 
					}
					else if ( $(this).hasClass("fddicenter") ) 
					{   
						var type='center';  
					}
					else if ( $(this).hasClass("fddi_subcenter") ) 
					{   
						var type='subcenter';   
					}
					else if ( $(this).hasClass("coursemenu") ) 
					{   
						var type='course';  
					}
					
				$.ajax({
					type:"post",
					url:uri,
					data:{vid:vid,type:type,subcenterid:subcenterid},
					dataType:'json',
					success:function(result){
						console.log(result);
						var table=result['table'];
						var counttot=result['counttot'];
						console.log(counttot);
						$('#tviewcount').html(counttot);
						$('#tviewtablebody').html(table);
					}
					
				});
				$('#totviewpara').show();
			});
		});
	</script>
